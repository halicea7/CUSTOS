# API — the API and worker refuse to start until SECRET_KEY is set.
# Generate each with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Encrypts stored repo credentials; defaults to SECRET_KEY if unset.
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# GitHub tokens and webhook secrets are configured per repo in the dashboard.

# Database (localhost for local dev; swap hostname to "postgres" for Docker)
DATABASE_URL=postgresql+asyncpg://Custos:Custos@localhost:5432/Custos

# Redis (localhost for local dev; swap hostname to "redis" for Docker)
REDIS_URL=redis://localhost:6379

# Ollama (local LLM — no code leaves GW infrastructure)
OLLAMA_BASE_URL=http://your-ollama-node:11434
OLLAMA_MODEL=qwen2.5-coder:32b

# Semgrep ruleset: "auto" (registry, sends usage metrics) or a local rules path.
SEMGREP_CONFIG=auto

# Analysis limits
CLONE_BASE_DIR=/tmp/Custos_clones
MAX_FILE_SIZE_KB=500
MAX_FILES_PER_REPO=200
