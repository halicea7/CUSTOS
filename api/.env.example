# ── Secrets (required) ────────────────────────────────────────────────────────
# Signs login tokens. The API refuses to start with a default or short value.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Encrypts stored GitHub tokens / webhook secrets. Comma-separate several keys
# to rotate (first encrypts, all decrypt), then run api/rotate_encryption.py.
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Local development only: allow a weak SECRET_KEY.
# ALLOW_INSECURE_DEFAULTS=true

ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Datastores ────────────────────────────────────────────────────────────────
# Local development. Docker Compose builds these from the values below instead.
DATABASE_URL=postgresql+asyncpg://Custos:Custos@localhost:5432/Custos
REDIS_URL=redis://localhost:6379

# Docker Compose only (root .env): credentials for the bundled services.
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=

# ── LLM ───────────────────────────────────────────────────────────────────────
# "ollama" (local — no code leaves your infrastructure) or "responses" (any
# OpenAI Responses API server; the code under review is SENT to it). These
# can also be set on the dashboard Settings page, which stores the key encrypted.
LLM_PROVIDER=ollama
# RESPONSES_BASE_URL=https://api.openai.com/v1
# RESPONSES_MODEL=
# RESPONSES_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://your-ollama-node:11434
OLLAMA_MODEL=qwen2.5-coder:32b
# Extra prompts per submission when a repo exceeds one prompt's budget.
LLM_MAX_BATCHES=4
LLM_CONCURRENCY=1
LLM_TIMEOUT_SECONDS=600

# ── Analysis ──────────────────────────────────────────────────────────────────
# Comma-separated Semgrep rulesets (registry names or local paths).
SEMGREP_CONFIG=p/default
CLONE_BASE_DIR=/tmp/Custos_clones
MAX_FILE_SIZE_KB=500
MAX_FILES_PER_REPO=200
STALE_JOB_MINUTES=60

# ── Login rate limiting ───────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=10
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=50
LOGIN_WINDOW_SECONDS=300

# GitHub tokens and webhook secrets are configured per repository in the
# dashboard (Repos page); there is no global token.
